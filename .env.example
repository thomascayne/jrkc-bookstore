# Required on Oracle/production. For local Docker, `npm run docker:up` generates
# strong values in the ignored `.env.docker.local` file when these are blank.
POSTGRES_OWNER_PASSWORD=
POSTGRES_PASSWORD=

# Optional integrations.
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=
NEXT_PUBLIC_GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1/volumes
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
