{
  "name": "jrkc-bookstore",
  "version": "1.4.8",
  "private": true,
  "title": "JRKC Bookstore",
  "appName": "JRKC Bookstore Management System",
  "authors": [
    {
      "name": "Joshua Castillo"
    },
    {
      "name": "Ricky Holder"
    },
    {
      "name": "Javon Kelley"
    },
    {
      "name": "Thomas Cayne"
    }
  ],
  "description": "Bookstore Management System for CTU University",
  "projectContext": "A collaborative college project created for the Colorado Technical University curriculum. It is educational team work, not the individual professional work of any one contributor.",
  "repositoryUrl": "https://github.com/thomascayne/jrkc-bookstore",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    },
    "esbuild": "^0.28.2",
    "postcss": "$postcss",
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "scripts": {
    "build": "next build",
    "dev": "node scripts/start-dev.mjs",
    "dev:https": "node server.mjs",
    "docker:build": "node scripts/docker-compose.mjs build",
    "docker:config": "node scripts/docker-compose.mjs config",
    "docker:port": "node scripts/docker-compose.mjs port",
    "docker:up": "node scripts/docker-compose.mjs up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-database.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "lint": "eslint . --max-warnings=0",
    "major-update": "node update-version.mjs major",
    "minor-update": "node update-version.mjs minor",
    "patch-update": "node update-version.mjs patch",
    "start": "next start",
    "test:branch-policy": "node --test scripts/branch-policy.test.mjs",
    "test:catalog-filters": "node --test scripts/catalog-filters.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-store": "^0.11.1",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "libphonenumber-js": "^1.13.12",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-svg-credit-card-payment-icons": "^6.0.4",
    "recharts": "^3.10.1",
    "stripe": "^22.6.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
